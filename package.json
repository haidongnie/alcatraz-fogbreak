{
  "name": "alcatraz-fogbreak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-decoders.mjs",
    "meshy:generate": "node scripts/meshy/generate.mjs",
    "meshy:optimize": "node scripts/meshy/optimize.mjs",
    "data:island": "node scripts/data/build-island.mjs",
    "test:rules": "rolldown tests/rules.test.ts --file node_modules/.cache/rules.test.mjs --format esm --platform node --log-level warn && node node_modules/.cache/rules.test.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "playroomkit": "^0.0.97",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "pngjs": "^7.0.0",
    "stats-gl": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
